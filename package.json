{
  "name": "spectre-tiling",
  "version": "1.0.0",
  "description": "Standalone Node.js implementation for generating Spectre tilings from 'A Chiral Aperiodic Monotile' by David Smith, Joseph Samuel Myers, Craig S. Kaplan, and Chaim Goodman-Strauss.",
  "main": "run_spectre.cjs",
  "scripts": {
    "start": "node run_spectre.cjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint *.cjs *.js",
    "lint:fix": "eslint *.cjs *.js --fix"
  },
  "keywords": [
    "spectre",
    "tiling",
    "aperiodic",
    "monotile",
    "geometry",
    "mathematics",
    "svg"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^30.2.0"
  },
  "dependencies": {
    "@flatten-js/core": "^1.6.10",
    "@flatten-js/polygon-offset": "^1.1.4"
  }
}
