{
  "name": "spectre-tiling",
  "version": "1.0.0",
  "description": "Standalone Node.js implementation for generating Spectre tilings from 'A Chiral Aperiodic Monotile' by David Smith, Joseph Samuel Myers, Craig S. Kaplan, and Chaim Goodman-Strauss.",
  "main": "run_spectre.cjs",
  "scripts": {
    "start": "node run_spectre.cjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint *.cjs *.js",
    "lint:fix": "eslint *.cjs *.js --fix"
  },
  "keywords": [
    "spectre",
    "tiling",
    "aperiodic",
    "monotile",
    "geometry",
    "mathematics",
    "svg"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "eslint": "^9.39.2",
    "jest": "^30.2.0"
  },
  "dependencies": {
    "js-clipper": "^1.0.1"
  },
  "overrides": {
    "glob": "^10.0.0",
    "test-exclude": "^7.0.0"
  }
}
